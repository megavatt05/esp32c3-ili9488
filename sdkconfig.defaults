# ====================== ESP32-C3 + LVGL 9 ======================
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_160=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# SPI performance
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ====================== Wi-Fi SoftAP (ESP32C3-DGW-SA1) ======================
# Точка доступа включена; память оптимизирована под AP-режим
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_BT_ENABLED=n

# ====================== LVGL 9 ======================
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Fonts
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

# Performance monitors off
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n

# !!! IMPORTANT FIX !!!
# Disable IRAM placement of LV_ATTRIBUTE_FAST_MEM
# On ESP-IDF 5.x/6.x + GCC 12+ this causes:
#   "ignoring attribute 'section (".iram1.xx")' because it conflicts..."
# See: https://github.com/lvgl/lvgl/issues/4391
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n

# LVGL include path: короткие #include "lvgl.h" в шрифтах и ui.c
# (без этой опции lv_font_conv-файлы ищут "lvgl/lvgl.h" и сборка падает)
CONFIG_LV_LVGL_H_INCLUDE_SIMPLE=y

# ====================== Сеть: фикс EMFILE (accept error 23) и стабильность SoftAP ======================
# Больше сокетов/PCB под всплеск подключений телефона (HTTPS-пробобы, captive portal)
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MEMP_NUM_TCP_PCB=16
CONFIG_LWIP_MEMP_NUM_TCP_PCB_LISTEN=8
CONFIG_LWIP_TCP_SND_BUF=5760
CONFIG_LWIP_TCP_WND=5760

# HTTP-сервер: достаточно слотов под одновременные соединения
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_SERVER_TIMEOUT=5

# Wi-Fi: SoftAP на фиксированном канале 6, только HT20 (20 МГц).
# Убирает дребезг "wifi:new:<6,0>/<6,1>" и проблемы совместимости HT40.
CONFIG_ESP_WIFI_SOFTAP_BEACON_MAX_LEN=752
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Консоль: UART0 (GPIO20/21) — ввод частоты SPI через терминал работает
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ====================== Проверено по официальной документации (окт. 2026) ======================
# LWIP: по docs ESP-IDF v6.0 (api-reference/protocols/lwip.html) сокет-опции
# переопределяют SO_REUSEADDR глобально. Без этого bind() DNS-перехвата на
# порт 53 и повторный старт HTTP-сервера падают после перезапуска клиента.
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y

# Wi-Fi SoftAP: фиксация HT20 (20 МГц). По docs esp_wifi_set_band_mode/
# secondary channel — HT40 на C3 вызывает дребезг "wifi:new:<6,0>/<6,1>"
# и reason=15 у клиентов. Канал 6 задаётся в коде (softap.c), здесь — буферы.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
