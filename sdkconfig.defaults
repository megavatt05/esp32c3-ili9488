# Стандартный пример UART Echo (ESP-IDF v6.0.3) в чистом виде:
# только драйверы UART, без LVGL/дисплея/Wi-Fi.
CONFIG_IDF_TARGET="esp32c3"

# Консоль через UART0 (GPIO20/21) — как в оригинальном примере IDF
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
